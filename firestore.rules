rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 각 사용자는 자기 일정만 읽고 쓸 수 있습니다.
    match /users/{uid}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 알림을 받을 이 사람의 기기 목록 (알림 서버는 서비스 계정으로 읽음)
    match /users/{uid}/devices/{deviceId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 예약된 알림: 자기 것만 만들고 고치고 지울 수 있습니다.
    match /reminders/{rid} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && rid == request.auth.uid + "_" + request.resource.data.itemId;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
    }
  }
}
